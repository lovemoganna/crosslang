;;; crosslang-shadow-tests.el --- Quiet presentation regressions -*- lexical-binding: t; -*-
(require 'ert)
(require 'crosslang)

(defun crosslang-shadow-test--response ()
  '(:text "Please check delivery date." :edits ((:start 13 :end 17 :text "delivery date")) :source "fixture"))

(ert-deftest crosslang-shadow-shows-only-replacement-at-its-source ()
  (with-temp-buffer
    (text-mode) (insert "Please check 交付日期.") (buffer-enable-undo) (crosslang-mode 1)
    (let ((source (buffer-string)) (undo buffer-undo-list) (position (point))
          (windows (current-window-configuration)) (requests 0))
      (setq-local crosslang-provider (list :operations '(express) :start (lambda (&rest _) (setq requests (1+ requests)))))
      (crosslang--show (list :operation 'express :text source :start 1 :end (point-max)) (crosslang-shadow-test--response))
      (should (= 1 (length crosslang--overlays)))
      (let* ((overlay (car crosslang--overlays)) (display (overlay-get overlay 'after-string)))
        (should (equal "交付日期" (buffer-substring-no-properties (overlay-start overlay) (overlay-end overlay))))
        (should (string-match-p "delivery date" display))
        (should-not (string-match-p "Please check\\|M--\\|\n" display))
        (should-not (eq (overlay-get overlay 'face) 'highlight)))
      (should (equal source (buffer-string))) (should (equal undo buffer-undo-list))
      (should (= position (point))) (should (= requests 0))
      (should (compare-window-configurations windows (current-window-configuration)))
      (should-not crosslang--preview))
    (crosslang-mode -1)))

(ert-deftest crosslang-shadow-details-have-local-diff-and-complete-text ()
  (with-temp-buffer
    (text-mode) (insert "Please check 交付日期.") (crosslang-mode 1)
    (let ((source (buffer-string)))
      (crosslang--show (list :operation 'express :text source :start 1 :end (point-max)) (crosslang-shadow-test--response))
      (crosslang-show-details)
      (with-current-buffer crosslang--preview
        (should (string-match-p "片段对照" (buffer-string)))
        (should (string-match-p "交付日期" (buffer-string)))
        (should (string-match-p "delivery date" (buffer-string)))
        (should (string-match-p "完整原文" (buffer-string)))
        (should (string-match-p "完整候选" (buffer-string))))
      (should (equal source (buffer-string))))
    (crosslang-mode -1)))

(ert-deftest crosslang-shadow-state-follows-pending-ready-and-dismiss ()
  (with-temp-buffer
    (text-mode) (insert "你好") (crosslang-mode 1)
    (let (callback)
      (setq-local crosslang-provider (list :operations '(express) :start (lambda (_ done) (setq callback done) nil)))
      (crosslang--request 'express (cons 1 3) t)
      (should (eq crosslang--ui-status 'working))
      (funcall callback '(:text "Hello" :edits ((:start 0 :end 2 :text "Hello"))))
      (should (eq crosslang--ui-status 'ready))
      (crosslang-dismiss)
      (should-not crosslang--ui-status)
      (should-not crosslang--overlays))
    (crosslang-mode -1)))

(ert-deftest crosslang-shadow-multiple-fragments-do-not-repeat-anchors-or-sort-original ()
  (with-temp-buffer
    (text-mode) (insert "API 日期 v2 预算") (crosslang-mode 1)
    (let* ((edits '((:start 10 :end 12 :text "budget") (:start 4 :end 6 :text "date")))
           (response (list :text "API date v2 budget" :edits edits)))
      (crosslang--show (list :operation 'express :text (buffer-string) :start 1 :end (point-max)) response)
      (should (= 2 (length crosslang--overlays)))
      (should (= 10 (plist-get (car (plist-get response :edits)) :start)))
      (dolist (overlay crosslang--overlays)
        (should-not (string-match-p "API\\|v2\\|M--\\|\n" (overlay-get overlay 'after-string)))))
    (crosslang-mode -1)))

(ert-deftest crosslang-shadow-blocked-is-a-short-badge ()
  (with-temp-buffer
    (text-mode) (insert "50 USD") (crosslang-mode 1)
    (crosslang--show '(:operation express :text "50 USD" :start 1 :end 7) '(:text "500 EUR"))
    (should (eq crosslang--ui-status 'blocked))
    (let ((display (overlay-get (car crosslang--overlays) 'after-string)))
      (should (string-match-p "已拦截" display))
      (should-not (string-match-p "500\\|M--\\|\n" display)))
    (crosslang-mode -1)))

(ert-deftest crosslang-shadow-full-candidate-is-labeled-not-fake-local-diff ()
  (with-temp-buffer
    (text-mode) (insert "你好") (crosslang-mode 1)
    (crosslang--show '(:operation express :text "你好" :start 1 :end 3) '(:text "Hello"))
    (should (string-match-p "整段" (overlay-get (car crosslang--overlays) 'after-string)))
    (crosslang-mode -1)))

(ert-deftest crosslang-shadow-reading-is-compact-and-details-keep-line-breaks ()
  (with-temp-buffer
    (text-mode) (insert "bank") (crosslang-mode 1)
    (crosslang--show '(:operation explain :text "bank" :start 1 :end 5) '(:text "银行\n本句指金融机构"))
    (should (eq crosslang--ui-status 'reading))
    (should-not (string-match-p "\n\\|M--" (overlay-get (car crosslang--overlays) 'after-string)))
    (crosslang-show-details)
    (with-current-buffer crosslang--preview (should (string-match-p "银行\n本句指金融机构" (buffer-string))))
    (crosslang-mode -1)))

(ert-deftest crosslang-shadow-long-text-still-requires-full-review-before-confirmation ()
  (with-temp-buffer
    (text-mode) (insert "原文") (crosslang-mode 1)
    (let ((candidate (make-string 220 ?a)))
      (crosslang--show (list :operation 'express :text "原文" :start 1 :end 3 :tick (buffer-chars-modified-tick))
                       (list :text candidate :edits (list (list :start 0 :end 2 :text candidate))))
      (should (< (length (overlay-get (car crosslang--overlays) 'after-string)) 70))
      (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) (ert-fail "Unseen text accepted"))))
        (should-error (crosslang-accept) :type 'user-error))
      (with-current-buffer crosslang--preview (should (string-match-p candidate (buffer-string)))))
    (crosslang-mode -1)))

(ert-deftest crosslang-shadow-uncertain-result-cannot-be-accepted ()
  (with-temp-buffer
    (text-mode) (insert "那个") (crosslang-mode 1)
    (crosslang--show '(:operation express :text "那个" :start 1 :end 3) '(:text "Which item?" :uncertain t))
    (should (eq crosslang--ui-status 'uncertain))
    (should (string-match-p "需澄清" (overlay-get (car crosslang--overlays) 'after-string)))
    (should-error (crosslang-accept) :type 'user-error)
    (crosslang-mode -1)))

(ert-deftest crosslang-shadow-failure-status-does-not-create-overlays ()
  (with-temp-buffer
    (text-mode) (insert "你好") (crosslang-mode 1)
    (setq-local crosslang-provider (list :operations '(express)
                                        :start (lambda (_ done) (funcall done '(:error "not available")) nil)))
    (crosslang--request 'express (cons 1 3) t)
    (should (eq crosslang--ui-status 'failed))
    (should-not crosslang--overlays)
    (crosslang-dismiss) (should-not crosslang--ui-status)
    (crosslang-mode -1)))
