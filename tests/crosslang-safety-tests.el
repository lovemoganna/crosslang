;;; crosslang-safety-tests.el --- Critical meaning and convenient keys -*- lexical-binding: t; -*-
(require 'ert)
(require 'crosslang-gptel)
(ert-deftest crosslang-safety-letter-t-is-never-an-editable-separator ()
  (should (equal '((0 2) (3 5))
                 (mapcar (lambda (s) (list (plist-get s :start) (plist-get s :end)))
                         (crosslang--spans "中文t中文" nil))))
  (should (equal '((0 5))
                 (mapcar (lambda (s) (list (plist-get s :start) (plist-get s :end)))
                         (crosslang--spans "中文\t中文" nil)))))
(ert-deftest crosslang-safety-swapped-amounts-rejected ()
  (should (crosslang--semantic-issues "at least 50, at most 100" "at least 100, at most 50")))
(ert-deftest crosslang-safety-currency-association-and-chinese-currency ()
  (should (crosslang--semantic-issues "50USD" "50EUR"))
  (should-not (crosslang--currency-sequence "USDA farm"))
  (should (crosslang--semantic-issues "50 USD, 100 EUR" "50 EUR, 100 USD"))
  (should (crosslang--semantic-issues "五十美元" "50 EUR")))
(ert-deftest crosslang-safety-unsupported-money-sign-and-percentage ()
  (should (crosslang--semantic-issues "五十点五美元" "5 USD"))
  (should (crosslang--semantic-issues "负五十美元" "50 USD"))
  (should (crosslang--semantic-issues "-50 USD" "50 USD"))
  (should (crosslang--semantic-issues "rate 50%" "rate 50"))
  (should (= 2026 (crosslang--chinese-number "二〇二六"))))
(ert-deftest crosslang-safety-chinese-money-and-upper-bound ()
  (should-not (crosslang--semantic-issues "预算不超过五十美元" "Budget must not exceed 50 USD"))
  (should (crosslang--semantic-issues "预算不超过五十美元" "Budget is 500 USD"))
  (should (crosslang--semantic-issues "至少 50" "at most 50")))
(ert-deftest crosslang-safety-lost-negation-and-unless ()
  (should (crosslang--semantic-issues "不要删除API" "Delete the API"))
  (should (crosslang--semantic-issues "除非批准，否则不要发送" "Send after approval")))
(ert-deftest crosslang-safety-ordered-amount-extraction ()
  (should (equal '("50" "100") (crosslang--ordered-amounts "预算五十美元，最多100元")))
  (should (equal '("12345") (crosslang--ordered-amounts "一万二千三百四十五元")))
  (should (equal '("50" "100") (crosslang--ordered-amounts "between 50 and 100 USD."))))
(ert-deftest crosslang-safety-convenient-prefix-only-while-enabled ()
  (with-temp-buffer
    (text-mode)
    (let ((before (key-binding (kbd "M--"))) (send (key-binding (kbd "C-c RET"))))
      (crosslang-mode 1)
      (should (eq (key-binding (kbd "C-c L e")) 'crosslang-express))
      (should (eq (key-binding (kbd "M--")) before))
      (should (eq (key-binding (kbd "C-c L a")) 'crosslang-accept))
      (should (eq send (key-binding (kbd "C-c RET"))))
      (crosslang-mode -1)
      (should (equal before (key-binding (kbd "M--")))))))
(ert-deftest crosslang-safety-invalid-meaning-never-reaches-confirmation ()
  (with-temp-buffer
    (text-mode) (insert "at least 50, at most 100") (crosslang-mode 1)
    (let ((original (buffer-string)))
      (crosslang--show (list :operation 'express :text original :start 1 :end (point-max)
                            :tick (buffer-chars-modified-tick)) '(:text "at least 100, at most 50"))
      (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) (ert-fail "unsafe confirmation reached"))))
        (should-error (crosslang-accept) :type 'user-error))
      (should (equal original (buffer-string)))
      (should (string-match-p "已拦截" (overlay-get (car crosslang--overlays) 'after-string))))
    (crosslang-mode -1)))
(ert-deftest crosslang-safety-reading-context-is-local-sentence ()
  (with-temp-buffer
    (insert "First unrelated sentence. The bank approved the loan. Another sentence.")
    (let* ((start (progn (goto-char 1) (search-forward "bank") (- (point) 4)))
           (context (crosslang--reading-context (cons start (+ start 4)))))
      (should (string-match-p "approved the loan" context))
      (should-not (string-match-p "unrelated" context))
      (should-not (string-match-p "Another" context)))))
(ert-deftest crosslang-safety-long-result-must-be-read-before-confirmation ()
  (with-temp-buffer
    (text-mode) (insert "Original") (crosslang-mode 1)
    (let ((original (buffer-string)))
      (crosslang--show (list :operation 'express :text original :start 1 :end (point-max)
                            :tick (buffer-chars-modified-tick)) (list :text (make-string 200 ?a)))
      (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) (ert-fail "unseen result accepted"))))
        (should-error (crosslang-accept) :type 'user-error))
      (should (buffer-live-p crosslang--preview))
      (should (equal original (buffer-string))))
    (crosslang-mode -1)))
(ert-deftest crosslang-safety-dwim-incoming-versus-draft ()
  (require 'gptel)
  (with-temp-buffer
    (org-mode) (gptel-mode 1)
    (insert (propertize "bank" 'gptel 'response) "\n" (gptel-prompt-prefix-string) "你好")
    (crosslang-mode 1)
    (let (operation)
      (cl-letf (((symbol-function 'crosslang-explain) (lambda () (setq operation 'reading)))
                ((symbol-function 'crosslang-express) (lambda () (setq operation 'express))))
        (goto-char 2) (crosslang-dwim) (should (eq operation 'reading))
        (goto-char (point-max)) (crosslang-dwim) (should (eq operation 'express))))
    (crosslang-mode -1) (gptel-mode -1)))
